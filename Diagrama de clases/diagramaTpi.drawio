        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass Usuario {\n    + int IdUsuario\n    + string NombreUsuario\n    + string Clave\n    + string Nombre\n    + string Apellido\n    + string Email\n    + Perfil Perfil\n    + bool Estado\n}\n\nenum Perfil {\n    Administrador\n    Telefonista\n    Supervisor\n}\n\nclass Cliente {\n    + int IdCliente\n    + string DNI\n    + string Nombre\n    + string Apellido\n    + string Email\n    + string Telefono\n    + bool Estado\n}\n\nclass Incidencia {\n    + int IdIncidencia\n    + string Problematica\n    + DateTime FechaCreacion\n    + EstadoIncidencia Estado\n    + string ComentarioRespuesta\n    + string ComentarioCierre\n    + Reasignar(nuevoSupervisor: Usuario)\n    + Modificar()\n    + Resolver(comentario: string)\n    + Cerrar(comentarioCierre: string)\n}\n\nenum EstadoIncidencia {\n    Abierto\n    Asignado\n    EnAnalisis\n    Resuelto\n    Cerrado\n    Reabierto\n}\n\nclass TipoIncidencia {\n    + int IdTipo\n    + string Descripcion\n    + bool Estado\n}\n\nclass Prioridad {\n    + int IdPrioridad\n    + string Descripcion\n    + bool Estado\n}\n\n&#39; Relaciones con sus multiplicidades y descripciones\nIncidencia \&quot;*\&quot; --&gt; \&quot;1\&quot; Cliente : pertenece a\nIncidencia \&quot;*\&quot; --&gt; \&quot;1\&quot; TipoIncidencia : clasificada por\nIncidencia \&quot;*\&quot; --&gt; \&quot;1\&quot; Prioridad : nivel de\nIncidencia \&quot;*\&quot; --&gt; \&quot;1\&quot; EstadoIncidencia : se encuentra en\nIncidencia \&quot;*\&quot; --&gt; \&quot;1\&quot; Usuario : UsuarioCreador\nIncidencia \&quot;*\&quot; --&gt; \&quot;1\&quot; Usuario : UsuarioAsignado\nUsuario \&quot;*\&quot; --&gt; \&quot;1\&quot; Perfil : tiene\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6fqt7UESCxOSL-kcijO9-27">
